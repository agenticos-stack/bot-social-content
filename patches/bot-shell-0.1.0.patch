+  --color-green-soft: #0f2a20;
+  --color-cyan: #5fdcff;
+  --color-cyan-soft: #08222d;
+  --color-amber: #e8a13a;
+  --color-amber-soft: #2a1e08;
+  --color-red: #ff5774;
+  --color-red-soft: #2c0f16;
+
+  --shadow-sm: 0 1px 1px rgba(0, 0, 0, 0.3), 0 1px 2px rgba(0, 0, 0, 0.3);

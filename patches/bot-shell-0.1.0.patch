@@ -0,0 +1,58 @@
+/* Opt-in, framework-neutral UI primitives. Load tokens.css first.
+ * Native HTML owns semantics and interaction; classes only own presentation. */
+:root {
+  --bot-space-1: 4px;
+  --bot-space-2: 8px;
+  --bot-space-3: 12px;
+  --bot-space-4: 16px;
+  --bot-space-6: 24px;
+  --bot-radius-control: 9px;
+  --bot-radius-card: 14px;
+  --bot-control-height: 40px;
+  --bot-text-body: 14px;
+  --bot-text-meta: 12px;
+}
+.bot-button.bot-button, .bot-input.bot-input {
+  box-sizing: border-box;
+  min-height: var(--bot-control-height);
+  border: 1px solid var(--color-line-strong);
+  border-radius: var(--bot-radius-control);
+  padding: var(--bot-space-2) var(--bot-space-3);
+  font: 500 var(--bot-text-body)/1.5 var(--font-sans);
+  color: var(--color-ink);
+  background: var(--color-panel);
+}
+.bot-button.bot-button { cursor: pointer; }
+.bot-button.bot-button:hover:not(:disabled) { background: var(--color-panel-subtle); }
+.bot-button.bot-button[data-variant="primary"] {
+  background: var(--color-act); border-color: var(--color-act-hover); color: var(--color-act-ink);
+}
+.bot-button.bot-button[data-variant="primary"]:hover:not(:disabled) { background: var(--color-act-hover); }
+.bot-button.bot-button:disabled { opacity: .5; cursor: not-allowed; }
+.bot-button.bot-button[aria-pressed="true"], .bot-button.bot-button[aria-selected="true"] {
+  background: var(--color-panel-subtle); font-weight: 650;
+}
+.bot-input.bot-input { width: 100%; min-width: 0; }
+textarea.bot-input.bot-input { min-height: 140px; resize: vertical; line-height: 1.8; }
+.bot-input.bot-input[aria-invalid="true"] { border-color: var(--color-red); }
+.bot-input.bot-input:disabled { background: var(--color-panel-subtle); opacity: .65; }
+.bot-button.bot-button:focus-visible, .bot-input.bot-input:focus-visible {
+  outline: 2px solid var(--color-act-hover); outline-offset: 2px;
+}
+.bot-card.bot-card { border: 1px solid var(--color-line); border-radius: var(--bot-radius-card); background: var(--color-panel); overflow: hidden; }
+.bot-card-body.bot-card-body { padding: var(--bot-space-4); }
+.bot-toolbar { display: flex; align-items: center; flex-wrap: wrap; gap: var(--bot-space-2); }
+.bot-field { display: grid; gap: var(--bot-space-2); }
+.bot-field > label { font: 600 var(--bot-text-meta)/1.5 var(--font-sans); color: var(--color-ink-soft); }
+.bot-empty { padding: var(--bot-space-6); color: var(--color-ink-soft); text-align: center; font: 400 var(--bot-text-body)/1.7 var(--font-sans); }
+.bot-badge { display: inline-flex; padding: var(--bot-space-1) var(--bot-space-2); border-radius: var(--bot-radius-control); background: var(--color-panel-subtle); color: var(--color-ink-soft); font: 500 var(--bot-text-meta)/1.5 var(--font-sans); }
+/* Modal dialog is document-scoped: in a canvas iframe it cannot cover the host.
+ * Do not portal this to a parent document. Use showModal()/close() for native focus/Escape. */
+dialog.bot-drawer { box-sizing: border-box; width: min(640px, 100vw); max-width: 100%; height: 100dvh; max-height: 100dvh; margin: 0 0 0 auto; padding: 0; border: 0; border-left: 1px solid var(--color-line); background: var(--color-panel); color: var(--color-ink); }
+.bot-drawer-sheet { height: 100%; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; }
+.bot-drawer-head, .bot-drawer-actions { display: flex; align-items: center; gap: var(--bot-space-2); padding: var(--bot-space-4); }
+.bot-drawer-head { border-bottom: 1px solid var(--color-line); }
+.bot-drawer-actions { border-top: 1px solid var(--color-line); }
+.bot-drawer-body { min-height: 0; overflow: auto; overscroll-behavior: contain; padding: var(--bot-space-6); overflow-wrap: anywhere; }
+@media (pointer: coarse) { :root { --bot-control-height: 44px; } .bot-input.bot-input { font-size: 16px; } }
+@media (max-width: 600px) { dialog.bot-drawer { width: 100%; } .bot-drawer-body { padding: var(--bot-space-4); } }
